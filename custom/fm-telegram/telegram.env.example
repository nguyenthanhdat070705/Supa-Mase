# Telegram bridge config for firstmate. Copy to telegram.env, fill in, chmod 600.
#
# 1) In Telegram, talk to @BotFather -> /newbot -> copy the HTTP API token here:
TG_BOT_TOKEN=123456789:AA-replace-with-your-real-bot-token
#
# 2) Message your new bot once (say "hi"), then run:  ./fm-tg-whoami.sh
#    Copy the chat_id it prints:
TG_CHAT_ID=000000000
#
# 3) tmux target where the Codex first mate runs — session:window[.pane].
#    Default assumes you ran:  tmux new -s firstmate   then   codex
TG_FM_TARGET=firstmate:0
TG_GROUP_IDS=   # cac group id cach nhau dau phay, vd: -100123,-100456
