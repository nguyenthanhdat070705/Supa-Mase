{
  "version": 1,
  "connections": {
    "business_ro": {
      "dsn_file": "/etc/firstmate-data/business-ro.dsn",
      "expected_role": "sm_analytics",
      "database": "postgres",
      "require_recovery": false
    }
  },
  "children": {
    "team-sandbox": {
      "connection": "business_ro",
      "tables": [
        {
          "schema": "business_example",
          "table": "orders",
          "relation_kind": "r",
          "columns": {"id": "int8", "region": "text", "total": "numeric"},
          "primary_key": ["id"],
          "catalog_fingerprint": "REPLACE_AFTER_OPERATOR_CATALOG_AND_DEPENDENCY_AUDIT",
          "audit_ref": "REPLACE_WITH_REVIEW_RECORD",
          "rls_reviewed": true,
          "row_visibility": "policy_filtered"
        }
      ]
    }
  },
  "limits": {"max_rows": 1000, "max_bytes": 2000000, "statement_timeout_ms": 15000, "max_concurrent": 2}
}
