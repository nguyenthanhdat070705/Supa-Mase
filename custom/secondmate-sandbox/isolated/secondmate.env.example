# Public IDs/config only. chmod 600 the completed file.
SM_CAPTAIN_ID=REPLACE_WITH_VERIFIED_TELEGRAM_USER_ID
SM_TEAM_GROUP_IDS=
SM_INSTANCE_FILE=/opt/secondmate/instance.json
SM_FORBIDDEN_BOT_ID=REPLACE_WITH_FIRSTMATE_BOT_ID
SM_BOT_TOKEN_FILE=/run/secrets/secondmate-bot-token
# No OpenAI/GitHub/Telegram tokens in this env file or source control.
# SM_TEAM_GROUP_IDS seeds the durable registry once; later captain /group_on,
# /group_off commands apply without restart. Put permanently excluded group IDs
# only in the private read-only instance.json, never in source control.
